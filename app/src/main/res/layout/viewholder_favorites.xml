<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="0dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/lightCream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgDrink"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:contentDescription="Drink Image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvDrinkName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Product Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/darkBrown"
            app:layout_constraintStart_toEndOf="@id/imgDrink"
            app:layout_constraintTop_toTopOf="@id/imgDrink"
            app:layout_constraintEnd_toStartOf="@id/btnRemoveFavorite"
            app:layout_constraintHorizontal_bias="0" />

        <TextView
            android:id="@+id/tvDrinkPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$4.99"
            android:textSize="16sp"
            android:textColor="@color/darkBrown"
            app:layout_constraintStart_toStartOf="@id/tvDrinkName"
            app:layout_constraintTop_toBottomOf="@id/tvDrinkName"
            app:layout_constraintEnd_toEndOf="@id/tvDrinkName" />

        <ImageView
            android:id="@+id/btnRemoveFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_remove"
            app:tint="@color/darkBrown"
            android:contentDescription="Xóa khỏi yêu thích"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
