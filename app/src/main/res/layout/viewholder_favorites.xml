<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="0dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/lightCream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgDrink"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:contentDescription="Drink Image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- NHÃN “Yêu thích” giữa ảnh -->
        <TextView
            android:id="@+id/labelFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorite"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_favorite_label"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintTop_toTopOf="@id/imgDrink"
            app:layout_constraintStart_toStartOf="@id/imgDrink"
            app:layout_constraintEnd_toEndOf="@id/imgDrink"
            app:layout_constraintHorizontal_bias="0.5" />

        <!-- TÊN SP -->

        <TextView
            android:id="@+id/tvDrinkName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Product Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/darkBrown"
            app:layout_constraintStart_toEndOf="@id/imgDrink"
            app:layout_constraintTop_toTopOf="@id/imgDrink"
            app:layout_constraintEnd_toStartOf="@id/btnRemoveFavorite"
            app:layout_constraintHorizontal_bias="0" />


        <!-- GIÁ + ĐÁNH GIÁ -->
        <LinearLayout
            android:id="@+id/layoutPriceRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvDrinkName"
            app:layout_constraintStart_toStartOf="@id/tvDrinkName"
            app:layout_constraintEnd_toEndOf="@id/tvDrinkName">

            <TextView
                android:id="@+id/tvDrinkPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$4.99"
                android:textSize="16sp"
                android:textColor="@color/darkBrown"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="⭐ 4.5"
                android:textSize="14sp"
                android:textColor="@color/darkBrown" />
        </LinearLayout>

        <!-- NÚT XÓA -->

        <ImageView
            android:id="@+id/btnRemoveFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_remove"
            app:tint="@color/darkBrown"
            android:contentDescription="Xóa khỏi yêu thích"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
