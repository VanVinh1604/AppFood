<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Quay lại"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <!-- Header -->
        <TextView
            android:id="@+id/textHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Always serving customers every day"
            android:textColor="#E86F3F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Order ID -->
        <TextView
            android:id="@+id/textOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Id:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Step Progress -->
        <LinearLayout
            android:id="@+id/stepLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="7.5">

            <!-- STEP 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step1Circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/circle_gray"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/step1Text"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Unconfirmed"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- LINE -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#BDBDBD"
                android:layout_gravity="center_vertical" />

            <!-- STEP 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step2Circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/circle_gray"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/step2Text"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="In Progress"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- LINE -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#BDBDBD"
                android:layout_gravity="center_vertical" />

            <!-- STEP 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step3Circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/circle_gray"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/step3Text"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Shipping"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- LINE -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.5"
                android:background="#BDBDBD"
                android:layout_gravity="center_vertical" />

            <!-- STEP 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step4Circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/circle_gray"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/step4Text"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="Delivered"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
        <!-- Địa chỉ -->
        <TextView
            android:id="@+id/textAddressTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Address"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Tên khách -->
        <TextView
            android:id="@+id/textCustomerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Số điện thoại -->
        <TextView
            android:id="@+id/textPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PhoneNumber:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Địa chỉ chi tiết -->
        <TextView
            android:id="@+id/textAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Thanh toán -->
        <TextView
            android:id="@+id/textPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment method:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Giao hàng -->
        <TextView
            android:id="@+id/textDeliveryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Ghi chú -->
        <TextView
            android:id="@+id/textNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Note:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
        <!-- Thời gian -->
        <TextView
            android:id="@+id/textOrderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order date:"
            android:textColor="@color/darkBrown"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Danh sách sản phẩm -->
        <TextView
            android:id="@+id/textProductTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 Product"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDrinkItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Thông tin Voucher -->
        <TextView
            android:id="@+id/textVoucherInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎟️ Voucher: ABC123 - Giảm 20.000đ"
            android:textColor="#4CAF50"
            android:textStyle="italic"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Giá gốc -->
        <TextView
            android:id="@+id/textOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giá gốc: 0 đ"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:textStyle="italic" />

        <!-- Tổng giá -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Total Price:"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 đ"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
