<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Mã đơn hàng -->
        <TextView
            android:id="@+id/orderIdTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã đơn hàng: ABC12345"
            android:textStyle="bold"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- Tên khách hàng -->
        <TextView
            android:id="@+id/nameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên khách hàng"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <!-- Tổng tiền -->
        <TextView
            android:id="@+id/priceTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng tiền: $0.0"
            android:textColor="#FF5722"
            android:layout_marginTop="4dp" />

        <!-- Voucher -->
        <TextView
            android:id="@+id/voucherTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎟️ Voucher: ABC123 (−20.000đ)"
            android:textColor="#4CAF50"
            android:textStyle="italic"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/statusTxt"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tình trạng: Đang xử lý" />

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/status_circle_defaul" />
        </LinearLayout>

        <!-- Ngày đặt -->
        <TextView
            android:id="@+id/timeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày đặt: --/--/----"
            android:layout_marginTop="4dp" />

        <!-- Địa chỉ nhận -->
        <TextView
            android:id="@+id/addressTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Địa chỉ nhận hàng"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
