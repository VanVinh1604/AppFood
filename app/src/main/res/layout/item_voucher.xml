<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="12dp"
    android:backgroundTint="@color/white"
    android:elevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Icon bên trái -->
        <ImageView
            android:id="@+id/voucherIcon"
            android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/voucher_icon"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


        <!-- CODE -->
        <TextView
            android:id="@+id/voucherCode"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="CODE123"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/darkBrown"
            app:layout_constraintStart_toEndOf="@id/voucherIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Mô tả -->
        <TextView
            android:id="@+id/voucherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="14sp"
            android:textColor="@color/gray"
            app:layout_constraintStart_toEndOf="@id/voucherIcon"
            app:layout_constraintTop_toBottomOf="@id/voucherCode"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Hạn dùng -->
        <TextView
            android:id="@+id/voucherExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HSD: 2025-12-31"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toEndOf="@id/voucherIcon"
            app:layout_constraintTop_toBottomOf="@id/voucherDesc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
