<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightCream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Icon ổ khóa -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/logopassword"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Lock Icon" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORGOT PASSWORD"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/darkBrown"
            android:layout_marginBottom="8dp" />

        <!-- Mô tả -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please enter your registered email to recover your password."
            android:textSize="14sp"
            android:textColor="#666666"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- EditText email -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter registered email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@drawable/edit_text_background"
            android:textColor="@color/darkBrown"
            android:textColorHint="#999999"
            android:layout_marginBottom="24dp" />

        <!-- Nút gửi email -->
        <Button
            android:id="@+id/btnSendReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEND RECOVERY EMAIL"
            android:backgroundTint="@color/orange"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Nút quay lại -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Come Back"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
